{
  "name": "bangla-call",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Open-source, dynamic IP-telephony (IPTSP) landing + lead portal for Bangla Call. React SPA on Cloudflare Pages with D1/KV/R2, a fully admin-editable CMS, AI number valuation, Telegram alerts, and camera/NID capture.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "cf:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint src worker",
    "test": "node test/smoke.mjs",
    "lint:fix": "eslint src worker --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "hono": "^4.6.14",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-is": "^19.0.0",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.8.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.3",
    "wrangler": "^4.45.0"
  }
}
